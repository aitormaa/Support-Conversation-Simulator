<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Support Conversation Simulator</title>
  <style>
    :root {
      --ink: #111116;
      --muted: #667085;
      --line: #e5e7eb;
      --surface: #ffffff;
      --canvas: #fbfbef;
      --soft: #f4f5f6;
      --mindaro: #ddfb69;
      --mindaro-dark: #b9df30;
      --blue: #dbeafe;
      --yellow: #e5fb72;
      --orange: #ffb08f;
      --shadow: 0 12px 32px rgba(17, 17, 22, .10);
      --radius: 20px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--canvas);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.45;
    }
    button, textarea { font: inherit; }
    button { cursor: pointer; }
    button:focus-visible, textarea:focus-visible { outline: 3px solid #7d5cff; outline-offset: 2px; }

    .shell { width: min(1180px, calc(100% - 32px)); margin: 0 auto; padding: 28px 0 36px; }
    .topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
    .kicker { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 10px; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
    .kicker-mark { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: var(--mindaro); font-weight: 900; color: var(--ink); }
    h1 { margin: 0; font-size: clamp(28px, 4vw, 42px); line-height: 1.05; letter-spacing: -.04em; }
    .intro { max-width: 720px; margin: 8px 0 0; color: var(--muted); font-size: 15px; }
    .reset { border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--muted); padding: 10px 13px; font-weight: 700; box-shadow: 0 3px 10px rgba(17,17,22,.05); }
    .reset:hover { color: var(--ink); border-color: #cbd5e1; }

    .command-grid, .preview-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .panel { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
    .command-panel { padding: 18px; }
    .panel-heading { display: flex; justify-content: space-between; gap: 14px; align-items: flex-start; margin-bottom: 13px; }
    .heading-left { display: flex; gap: 10px; align-items: flex-start; }
    .step { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: var(--mindaro); font-size: 13px; font-weight: 900; }
    .step.blue { background: var(--blue); color: #1d4ed8; }
    .panel-title { margin: 0; font-size: 16px; }
    .panel-help { margin: 3px 0 0; color: var(--muted); font-size: 12px; }
    .command-tag { padding: 5px 8px; border-radius: 999px; background: #eefbd0; color: #3f6212; font-size: 11px; font-weight: 800; white-space: nowrap; }
    .command-tag.blue { background: #e0ecff; color: #1d4ed8; }
    .terminal { border-radius: 14px; padding: 13px; background: #111827; color: #f8fafc; }
    .terminal-label { display: flex; align-items: center; gap: 7px; margin-bottom: 8px; color: #94a3b8; font-size: 11px; }
    textarea { display: block; width: 100%; min-height: 78px; resize: vertical; border: 0; background: transparent; color: #f8fafc; font: 13px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; outline: 0; }
    .syntax { margin-top: 8px; padding-top: 8px; border-top: 1px solid #374151; color: #94a3b8; font-size: 11px; }
    .syntax code { color: #bef264; }
    .syntax.blue code { color: #93c5fd; }
    .action { width: 100%; margin-top: 12px; border: 0; border-radius: 12px; padding: 11px 14px; font-weight: 800; background: var(--mindaro); color: var(--ink); }
    .action:hover { background: var(--mindaro-dark); }
    .action.dark { background: var(--ink); color: #fff; }
    .action.dark:hover { background: #34343b; }
    .status { min-height: 18px; margin: 8px 0 0; color: #3f6212; font-size: 12px; font-weight: 700; }
    .status.blue { color: #1d4ed8; }

    .section-label { display: flex; align-items: center; gap: 8px; margin: 26px 0 11px; color: var(--muted); font-size: 12px; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
    .section-label::after { content: ""; height: 1px; flex: 1; background: var(--line); }
    .preview-card { overflow: hidden; }
    .preview-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
    .preview-title { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 800; }
    .preview-meta { color: var(--muted); font-size: 12px; }
    .inbox-top { padding: 18px 16px; border-bottom: 1px solid var(--line); }
    .person { display: flex; align-items: center; gap: 10px; }
    .avatar { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--orange); font-weight: 900; }
    .person-name { font-size: 14px; font-weight: 800; }
    .person-sub { margin-top: 2px; color: var(--muted); font-size: 11px; }
    .issue-label { margin-top: 16px; color: var(--muted); font-size: 12px; }
    .issue { display: flex; align-items: flex-start; gap: 8px; margin-top: 5px; font-size: 14px; font-weight: 800; }
    .dot { width: 6px; height: 6px; flex: 0 0 auto; margin-top: 7px; border-radius: 50%; background: var(--ink); }
    .thread { display: flex; flex-direction: column; gap: 10px; padding: 16px; background: #f8fafc; min-height: 190px; }
    .thread-label { color: var(--muted); font-size: 11px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
    .bubble { max-width: 88%; border-radius: 17px; padding: 11px 13px; font-size: 13px; }
    .bubble.customer { align-self: flex-start; border-bottom-left-radius: 5px; background: #edf0f2; }
    .bubble.agent { align-self: flex-end; border-bottom-right-radius: 5px; background: var(--blue); }
    .reply-author { margin-top: 5px; color: var(--muted); font-size: 10px; }
    .composer { padding: 16px; border-top: 1px solid var(--line); }
    .composer-box { border: 1px solid #dbe0e6; border-radius: 13px; padding: 12px; background: #fff; }
    .composer-title { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 800; }
    .composer-help { margin: 16px 0; color: var(--muted); font-size: 13px; }
    .composer-footer { display: flex; align-items: center; justify-content: space-between; color: var(--muted); }
    .send-small { border: 0; border-radius: 9px; padding: 8px 11px; background: #eef0f2; color: #64748b; font-size: 12px; font-weight: 800; }

    .mobile-wrap { padding: 16px; background: #eef0f2; }
    .phone { width: min(100%, 360px); margin: 0 auto; overflow: hidden; border: 8px solid #111116; border-radius: 29px; background: #fff; box-shadow: 0 12px 24px rgba(17,17,22,.18); }
    .mobile-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 13px; font-size: 11px; }
    .support-brand { display: flex; align-items: center; gap: 7px; }
    .brand-mark { display: grid; place-items: center; width: 25px; height: 25px; border-radius: 50%; background: var(--mindaro); font-size: 10px; font-weight: 900; }
    .support-name { font-weight: 800; }
    .active { color: var(--muted); font-size: 9px; }
    .order-pill { padding: 9px 12px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: center; }
    .order-pill span { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); border-radius: 999px; padding: 6px 10px; font-size: 10px; box-shadow: 0 2px 6px rgba(17,17,22,.05); }
    .mobile-thread { display: flex; flex-direction: column; gap: 8px; min-height: 390px; padding: 14px 10px; background: #fff; }
    .mobile-bubble { max-width: 88%; border-radius: 17px; padding: 9px 11px; font-size: 11px; line-height: 1.45; }
    .mobile-bubble.grey { align-self: flex-start; background: #f0f1f2; }
    .mobile-bubble.support { align-self: flex-start; background: #f0f1f2; }
    .mobile-bubble.yellow { align-self: flex-end; border-bottom-right-radius: 5px; background: var(--yellow); }
    .mobile-system { align-self: center; padding: 4px 0; color: var(--muted); font-size: 10px; }
    .mobile-input { display: flex; align-items: center; gap: 8px; padding: 10px; border-top: 1px solid var(--line); color: var(--muted); font-size: 10px; }
    .fake-send { display: grid; place-items: center; width: 28px; height: 28px; margin-left: auto; border-radius: 50%; background: #e3e5e8; }

    .footer-note { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; padding: 13px 15px; border: 1px solid var(--line); border-radius: 15px; background: rgba(255,255,255,.7); color: var(--muted); font-size: 11px; }
    .footer-note strong { color: var(--ink); }
    @media (max-width: 820px) {
      .command-grid, .preview-grid { grid-template-columns: 1fr; }
      .topbar { flex-direction: column; }
      .reset { align-self: flex-start; }
    }
    @media (max-width: 480px) {
      .shell { width: min(100% - 20px, 1180px); padding-top: 18px; }
      .command-panel { padding: 14px; }
      .preview-header, .inbox-top, .composer { padding-left: 13px; padding-right: 13px; }
      .footer-note { align-items: flex-start; flex-direction: column; }
    }
  </style>
</head>
<body>
  <main class="shell" aria-labelledby="page-title">
    <header class="topbar">
      <div>
        <div class="kicker"><span class="kicker-mark">⌘</span> Training workspace</div>
        <h1 id="page-title">Support Conversation Simulator</h1>
        <p class="intro">Build a customer scenario with one command, then rehearse the agent reply in synchronized desktop and mobile views.</p>
      </div>
      <button class="reset" id="resetButton" type="button">↻ Reset example</button>
    </header>

    <section class="command-grid" aria-label="Simulator commands">
      <article class="panel command-panel">
        <div class="panel-heading">
          <div class="heading-left">
            <span class="step">1</span>
            <div><h2 class="panel-title">Build customer scenario</h2><p class="panel-help">Edit the help topic and customer message together.</p></div>
          </div>
          <span class="command-tag">/scenario</span>
        </div>
        <div class="terminal">
          <div class="terminal-label">▣ Command</div>
          <textarea id="scenarioCommand" aria-label="Scenario command">/scenario issue: Unexpected shutdown/restart | customer: I logged into Back Market, but the order isn't in My Orders.</textarea>
          <div class="syntax">Syntax: <code>/scenario issue: ... | customer: ...</code></div>
        </div>
        <button class="action" id="applyScenario" type="button">✓ Apply scenario</button>
        <p class="status" id="scenarioStatus" aria-live="polite"></p>
      </article>

      <article class="panel command-panel">
        <div class="panel-heading">
          <div class="heading-left">
            <span class="step blue">2</span>
            <div><h2 class="panel-title">Simulate agent response</h2><p class="panel-help">Write the next support reply and add it to both conversations.</p></div>
          </div>
          <span class="command-tag blue">/reply</span>
        </div>
        <div class="terminal">
          <div class="terminal-label">▣ Command</div>
          <textarea id="replyCommand" aria-label="Reply command">/reply Hi Michael, I’m checking this for you now.</textarea>
          <div class="syntax blue">Syntax: <code>/reply Your response to the customer</code></div>
        </div>
        <button class="action dark" id="sendReply" type="button">➤ Send agent reply</button>
        <p class="status blue" id="replyStatus" aria-live="polite"></p>
      </article>
    </section>

    <div class="section-label">Live previews</div>
    <section class="preview-grid" aria-label="Live conversation previews">
      <article class="panel preview-card">
        <div class="preview-header"><div class="preview-title">▤ Agent inbox preview</div><div class="preview-meta">Ticket #37519503 · Michael Smith</div></div>
        <div class="inbox-top">
          <div class="person"><div class="avatar">M</div><div><div class="person-name">Order #70430164 conversation</div><div class="person-sub">Michael Smith · active</div></div></div>
          <div class="issue-label">What you need help with:</div>
          <div class="issue"><span class="dot"></span><span id="desktopIssue"></span></div>
        </div>
        <div class="thread">
          <div class="thread-label">Customer message</div>
          <div class="bubble customer" id="desktopCustomer"></div>
          <div id="desktopReplies"></div>
        </div>
        <div class="composer"><div class="composer-box"><div class="composer-title">▰ Reply⌄</div><p class="composer-help">Use the <strong>/reply</strong> command above to simulate the agent response.</p><div class="composer-footer"><span>ϟ</span><button class="send-small" id="sendSmall" type="button">➤ Send</button></div></div></div>
      </article>

      <article class="panel preview-card">
        <div class="preview-header"><div class="preview-title">▣ Customer mobile preview</div><div class="preview-meta">Live sync</div></div>
        <div class="mobile-wrap">
          <div class="phone">
            <div class="mobile-header"><span>‹</span><div class="support-brand"><div class="brand-mark">&lt;&lt;</div><div><div class="support-name">Back Market Support</div><div class="active">● Active</div></div></div><span>•••</span></div>
            <div class="order-pill"><span>▰ Order #70430164 conversation</span></div>
            <div class="mobile-thread">
              <div class="mobile-bubble grey">Let's get your item ready to be returned for a repair. <u>See return details</u></div>
              <div class="mobile-bubble grey">Feel free to add any more details here in the meantime.</div>
              <div class="mobile-bubble grey">Here's a recap of what you already shared.<br>Please note that any photos will take a moment to load.<br><br>What you need help with:<br>• <span id="mobileIssue"></span></div>
              <div class="mobile-system">▰ Ticket has been updated · now</div>
              <div id="mobileReplies"></div>
              <div class="mobile-bubble yellow">“<span id="mobileCustomer"></span>”</div>
            </div>
            <div class="mobile-input"><span>⌕</span><span>☺</span><span>♩</span><span class="fake-send">➤</span></div>
          </div>
        </div>
      </article>
    </section>

    <div class="footer-note"><span><strong>Synchronized fields:</strong> issue bullet, desktop customer bubble, mobile yellow bubble</span><span>Training mode · client-side preview</span></div>
  </main>

  <script>
    (() => {
      const initial = {
        issue: 'Unexpected shutdown/restart',
        customer: "I logged into Back Market, but the order isn't in My Orders."
      };
      let state = { issue: initial.issue, customer: initial.customer, replies: [] };

      const $ = (id) => document.getElementById(id);
      const scenarioCommand = $('scenarioCommand');
      const replyCommand = $('replyCommand');

      function parseScenario(value) {
        const text = value.trim();
        let issue = state.issue;
        let customer = state.customer;
        const scenario = text.match(/^\/scenario\s+(.+)$/i);
        if (scenario) {
          const body = scenario[1];
          const issueMatch = body.match(/issue\s*[:=]\s*(.*?)(?:\s*\|\s*customer\s*[:=]|$)/i);
          const customerMatch = body.match(/customer\s*[:=]\s*(.*)$/i);
          if (issueMatch && issueMatch[1].trim()) issue = issueMatch[1].trim().replace(/^['"]|['"]$/g, '');
          if (customerMatch && customerMatch[1].trim()) customer = customerMatch[1].trim().replace(/^['"]|['"]$/g, '');
        } else if (/^\/issue\s+/i.test(text)) {
          issue = text.replace(/^\/issue\s+/i, '').trim();
        } else if (/^\/customer\s+/i.test(text)) {
          customer = text.replace(/^\/customer\s+/i, '').trim();
        }
        return { issue: issue || initial.issue, customer: customer || initial.customer };
      }

      function addReply() {
        const text = replyCommand.value.replace(/^\/reply\s*/i, '').trim();
        if (!text) return;
        state.replies.push(text);
        $('replyStatus').textContent = 'Reply added to the desktop and mobile previews.';
        render();
      }

      function renderReplies() {
        const desktop = state.replies.map((reply) => '<div class="bubble agent">' + escapeHtml(reply) + '<div class="reply-author">Back Market Support</div></div>').join('');
        const mobile = state.replies.map((reply) => '<div class="mobile-bubble support">' + escapeHtml(reply) + '<br><span class="reply-author">Back Market Support</span></div>').join('');
        $('desktopReplies').innerHTML = desktop;
        $('mobileReplies').innerHTML = mobile;
      }

      function escapeHtml(value) {
        return value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character]));
      }

      function render() {
        $('desktopIssue').textContent = state.issue;
        $('mobileIssue').textContent = state.issue;
        $('desktopCustomer').textContent = state.customer;
        $('mobileCustomer').textContent = state.customer;
        renderReplies();
      }

      $('applyScenario').addEventListener('click', () => {
        const next = parseScenario(scenarioCommand.value);
        state.issue = next.issue;
        state.customer = next.customer;
        $('scenarioStatus').textContent = 'Scenario updated. Both previews are synchronized.';
        $('replyStatus').textContent = '';
        render();
      });
      $('sendReply').addEventListener('click', addReply);
      $('sendSmall').addEventListener('click', addReply);
      $('resetButton').addEventListener('click', () => {
        state = { issue: initial.issue, customer: initial.customer, replies: [] };
        scenarioCommand.value = '/scenario issue: ' + initial.issue + ' | customer: ' + initial.customer;
        replyCommand.value = '/reply Hi Michael, I’m checking this for you now.';
        $('scenarioStatus').textContent = '';
        $('replyStatus').textContent = '';
        render();
      });
      render();
    })();
  </script>
</body>
</html>
